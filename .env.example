# Copy to .env and fill in. Never commit the real .env file.

# Site identity
PROJECT_NAME=Sangath Group
SITE_NAME=Main Gate

# Camera: 0 = first USB webcam, or an RTSP URL from the site NVR/CCTV
# CAMERA_SOURCE=rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101
CAMERA_SOURCE=0

# Telegram alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard login (strongly recommended on any shared network)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Working hours (24h) - unknown faces outside these hours are escalated to High
WORK_START_HOUR=8
WORK_END_HOUR=20

# Recognition tuning
MATCH_TOLERANCE=0.5
PROCESS_EVERY_N_FRAMES=3
FRAME_SCALE=0.5
KNOWN_COOLDOWN_MIN=10
UNKNOWN_COOLDOWN_MIN=5
ON_SITE_WINDOW_MIN=60

# Server (use HOST=0.0.0.0 to open the dashboard from other PCs on the site LAN)
HOST=127.0.0.1
PORT=5000
